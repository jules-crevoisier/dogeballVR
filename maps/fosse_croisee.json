  "rules": {
    "hearts": 2,
    "hitCost": "une balle retire 1 cœur, quel que soit son palier (doubleDamageCharge = 0 ; 2 rétablirait l'ancien KO au palier 2)",
    "friendlyFire": false,
    "heldBallMaxSeconds": 10,
    "friendlyFireNote": "y compris pour la bombe en v3 (simplification, contrairement à Knockout City)",
    "heartRegen": "remis à 2 au respawn ; en VR, +1 cœur après 10 s sans être touché (heartRegenSeconds) ; au clavier, aucune régénération (pcHeartRegenSeconds = 0)",
    "invulnerableAfterHitSeconds": 0.4,
    "catchReward": "attraper ne rend pas de cœur (catchHealsHeart = false) ; une attrape parfaite d'un tir adverse renvoie la balle avec 1 palier de plus (palier 3 au plus)",
    "respawnSeconds": 3,
    "chargeByPass": "paliers 0 à 3 : une passe d'allié porte la balle au palier 1 (pas plus), une attrape parfaite ajoute 1 palier ; le palier ne change pas les dégâts : en VR il raccourcit la fenêtre d'attrape normale de celui qui reçoit (0,35 / 0,30 / 0,27 / 0,25 s, vrCatchWindowCutByCharge), au clavier il accélère le tir (+15 % par palier : 24 / 27,6 / 31,7 / 36,5 m/s, plafond 40)",
    "passInterception": "une passe adverse s'intercepte par n'importe quelle attrape (interceptPasses = true), et une attrape parfaite lui ajoute 1 palier ; une passe ne blesse personne",
    "missedCatchLock": "VR : un grip qui expire sans contact alors qu'un vrai tir adverse arrivait (moins de 0,6 s) bloque la main 0,6 s (vrMissedCatchLockSeconds) ; jamais sur un plot ni une balle au sol ; au clavier, le clic droit garde son propre blocage de 0,6 s après tout appui raté",
    "roundBreak": "pause de 20 s entre deux manches en VR (vrRoundBreakSeconds), 12 s au clavier (pcRoundBreakSeconds), avec écran d'intermission",
    "specialBallTarget": "l'équipe menée, pas la plaque (survit aux échanges)",
    "roundFormat": "5 manches de 2 min ; une manche s'arrête aussi quand une équipe atteint le seuil de KO ; égalité en fin de manche = mort subite (premier KO) ; équipe menée à 0-0 = tirage au sort",
    "parry": "paume ouverte (VR) ou clic droit pressé tôt (PC) : dévie une balle sans charge",
    "stuckBallReturnSeconds": 3,
    "ringOut": "PC : être poussé dans la fosse (tacle, poussée de 2,0 m, sans effet pendant l'invulnérabilité) = KO pour la victime ; tomber seul coûte 1 cœur ; rebord de 0,3 m autour de la fosse ; le dash s'arrête à 0,8 m du vide",
    "coverPhasing": "une balle ne traverse pas un couvert ; en VR, tête dans un couvert = fondu, reste touchable",
    "heartRegenSeconds": 10,
    "koTarget": 6
  },
  "modes": {
    "team_ko": {

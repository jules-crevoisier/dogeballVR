    <TargetFramework Condition=" '$(GodotTargetsAndroid)' == 'true' ">net7.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>DogeballVR</RootNamespace>
    <AssemblyName>DogeballVR</AssemblyName>
